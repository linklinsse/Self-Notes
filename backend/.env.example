# Backend configuration for local development (npm run dev).  cp .env.example .env
# Database from: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://selfnotes:change-me@localhost:5432/selfnotes
JWT_SECRET=dev-only-secret-dev-only-secret-dev-only-secret
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=https://localhost,http://localhost
LOG_LEVEL=debug
