// Self-Notes database schema. Documentation: docs/data-model.md
//
// Some database objects cannot be expressed in Prisma and live only in the SQL migrations:
//   - note_members_one_owner  (partial unique index: exactly one owner per note)
//   - categories_user_name_ci (unique index on user_id + lower(name))
//   - notes_*_trgm            (pg_trgm GIN indexes used by search)
//   - CHECK constraints       (category color format, share link role, username format)
//   - notes.sort_title        (GENERATED column with the ICU collation "und-x-icu"; read-only)
// When generating a new migration with `prisma migrate dev --create-only`, delete any
// statement that would drop them before applying it.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NoteType {
  text
  list

  @@map("note_type")
}

enum NoteRole {
  owner
  editor
  viewer

  @@map("note_role")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(32)
  passwordHash String   @map("password_hash")
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     Session[]
  memberships  NoteMember[]
  categories   Category[]
  shareLinks   ShareLink[]
  updatedNotes Note[]       @relation("NoteUpdatedBy")

  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  replacedById String?   @unique @map("replaced_by") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  client       String?   @db.VarChar(16)
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   Session? @relation("SessionReplacement")

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

model Note {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @default("") @db.VarChar(200)
  type        NoteType
  content     String   @default("")
  /// Generated by the database from title (raw SQL): never written by the app.
  sortTitle   String?  @map("sort_title")
  /// NOTE-17: content is an encrypted envelope (see lib/encrypted-content.ts); title stays readable.
  locked      Boolean  @default(false)
  version     Int      @default(1)
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  updatedBy  User?          @relation("NoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  members    NoteMember[]
  categories NoteCategory[]
  shareLinks ShareLink[]

  @@map("notes")
}

model NoteMember {
  noteId    String   @map("note_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      NoteRole
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId, role])
  @@map("note_members")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(40)
  color     String   @db.Char(7)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteCategory[]

  @@index([userId])
  @@map("categories")
}

model NoteCategory {
  noteId     String @map("note_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([noteId, categoryId])
  @@index([categoryId])
  @@map("note_categories")
}

model ShareLink {
  id          String    @id @default(uuid()) @db.Uuid
  noteId      String    @map("note_id") @db.Uuid
  token       String    @unique @db.VarChar(64)
  role        NoteRole
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)

  note      Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("share_links")
}
