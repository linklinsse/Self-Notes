// Self-Notes database schema (SQLite). Documentation: docs/data-model.md
//
// Some database objects cannot be expressed in Prisma and live only in the SQL migrations:
//   - note_members_one_owner (partial unique index: exactly one owner per note)
//   - CHECK constraints      (username format, category color format, share link role)
// To change a table, SQLite migrations rebuild it ("RedefineTables"), which loses them: when
// generating a migration with `prisma migrate dev --create-only`, add them back to the rebuilt
// table before applying it.
//
// Folded keys (lower case, no accents) are written by the app, never by SQLite: see
// src/lib/fold.ts. They give case- and accent-insensitive search, sort and name checks.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum NoteType {
  text
  list
}

enum NoteRole {
  owner
  editor
  viewer
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions     Session[]
  memberships  NoteMember[]
  categories   Category[]
  shareLinks   ShareLink[]
  updatedNotes Note[]       @relation("NoteUpdatedBy")

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  tokenHash    String    @unique @map("token_hash")
  replacedById String?   @unique @map("replaced_by")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  client       String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   Session? @relation("SessionReplacement")

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

model Note {
  id          String   @id @default(uuid())
  title       String   @default("")
  type        NoteType
  content     String   @default("")
  /// fold(title), NULL when the title is blank: search and the A to Z order (untitled notes last).
  titleKey    String?  @map("title_key")
  /// fold(content), empty when the note is locked: search (NOTE-10).
  contentKey  String   @default("") @map("content_key")
  /// NOTE-17: content is an encrypted envelope (see lib/encrypted-content.ts); title stays readable.
  locked      Boolean  @default(false)
  version     Int      @default(1)
  updatedById String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  updatedBy  User?          @relation("NoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  members    NoteMember[]
  categories NoteCategory[]
  shareLinks ShareLink[]

  @@map("notes")
}

model NoteMember {
  noteId    String   @map("note_id")
  userId    String   @map("user_id")
  role      NoteRole
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId, role])
  @@map("note_members")
}

model Category {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  /// name in lower case: a user's category names are unique regardless of case (CAT-1).
  nameKey   String   @map("name_key")
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteCategory[]

  @@unique([userId, nameKey])
  @@map("categories")
}

model NoteCategory {
  noteId     String @map("note_id")
  categoryId String @map("category_id")

  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([noteId, categoryId])
  @@index([categoryId])
  @@map("note_categories")
}

model ShareLink {
  id          String    @id @default(uuid())
  noteId      String    @map("note_id")
  token       String    @unique
  role        NoteRole
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")

  note      Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("share_links")
}
