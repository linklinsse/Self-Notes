{
  "name": "self-notes-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Self-Notes REST API (version comes from /VERSION)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "openapi": "tsx src/scripts/export-openapi.ts openapi.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.18",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
