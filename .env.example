# Self-Notes — runtime configuration for docker compose.
# Copy to .env and change every value marked "change-me":  cp .env.example .env

# Public URL where the web app is reachable (used to build share links).
PUBLIC_URL=http://localhost:9292

# Host port the web app (nginx: front + /api proxy) listens on.
APP_PORT=9292

# Host port of the API (backend). Loopback only by default; the app does not need it (it goes
# through APP_PORT/api). Write API_PORT=9191 to open it on every interface (see docs/deployment.md).
API_PORT=127.0.0.1:9191

# PostgreSQL. Use only URL-safe characters in the password (it is embedded in DATABASE_URL).
POSTGRES_DB=selfnotes
POSTGRES_USER=selfnotes
POSTGRES_PASSWORD=change-me

# Secret used to sign access tokens (JWT), at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me

# Access token lifetime.
ACCESS_TOKEN_TTL=15m
# Session idle timeout (sliding): a session ends after this long WITHOUT use.
# Every use restarts it, and Android widgets refresh every 30 min, so phones stay signed in.
REFRESH_TOKEN_TTL=30d

# Account creation. Set to false to close sign-up once your accounts exist: the server then
# refuses new accounts, and the login page no longer offers to create one.
ALLOW_REGISTRATION=true

# Extra origins allowed by CORS (the Android app's WebView origin is https://localhost).
# The PUBLIC_URL origin is always allowed. Add other web fronts whose users pick this server on their login page.
CORS_ORIGINS=https://localhost,http://localhost

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Number of reverse proxies in front of the API: 1 = the bundled nginx ("web").
# Use 2 if you add your own HTTPS proxy (Caddy, Traefik…) in front of it.
TRUST_PROXY=1
# Blocks an IP that asks for too many unknown share links (anti brute force).
SHARE_LINK_MAX_FAILURES=10
SHARE_LINK_BLOCK=15m
